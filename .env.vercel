# ==============================================================================
# VERCEL ENVIRONMENT VARIABLES (Copy & Paste into Vercel Dashboard)
# Go to: Vercel Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AUTH & JWT SECRET (Required)
# ------------------------------------------------------------------------------
JWT_SECRET=smartnest_super_secret_jwt_key_2026

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT
# ------------------------------------------------------------------------------
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. CLOUD MYSQL DATABASE (Required for Vercel Backend)
# Note: Vercel runs in the cloud (AWS Lambda), so it cannot reach "localhost:3306".
# You can use a free Cloud MySQL provider like TiDB Cloud, Aiven, Railway, or PlanetScale.
# ------------------------------------------------------------------------------
# Option A: Full Connection String (Recommended for TiDB / Aiven / Railway)
# DATABASE_URL=mysql://<user>:<password>@<host>:<port>/smartnest_db?ssl={"rejectUnauthorized":true}

# Option B: Individual Host Credentials
DB_HOST=your-cloud-mysql-host.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=smartnest_db
DB_SSL=true

# ------------------------------------------------------------------------------
# 4. FRONTEND API ROUTE (Vite)
# ------------------------------------------------------------------------------
# When both frontend & backend run on Vercel together, keep this empty or "/api".
# If backend is on Render/Railway/VPS, put your full backend URL:
# VITE_API_URL=https://your-backend.onrender.com
VITE_API_URL=

# ------------------------------------------------------------------------------
# 5. OPTIONAL SUPABASE (Leave empty if not using)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
