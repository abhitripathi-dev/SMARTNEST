# ============================================================
# SmartNest Environment Configuration
# ============================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=smartnest_super_secret_jwt_key_2026

# 2. Database Configuration (Optional - Defaults to Embedded SQLite WAL if not set)
# For Free Cloud Database (e.g. TiDB Serverless, Aiven MySQL, or Railway MySQL):
# DATABASE_URL=mysql://user:password@gateway.region.tidbcloud.com:4000/smartnest_db?ssl={"rejectUnauthorized":true}
# OR standard host parameters:
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=smartnest_db
# DB_SSL=true

# 3. Frontend Vercel Configuration
# Set this in your Vercel Project Environment Variables:
# VITE_API_URL=https://your-backend-app.onrender.com
