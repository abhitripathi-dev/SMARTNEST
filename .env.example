# ==============================================================================
# SmartNest Environment Configuration (.env.example)
# Use this reference for Local Development, Docker, Vercel, and Render deployments
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVER & SECURITY
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=production
JWT_SECRET=smartnest_super_secret_jwt_key_2026_change_in_production

# ------------------------------------------------------------------------------
# 2. MYSQL DATABASE CREDENTIALS (Required)
# ------------------------------------------------------------------------------
# Option A: Discrete Connection Parameters
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=smartnest_root_pass
DB_NAME=smartnest_db
DB_SSL=false

# Option B: Single Connection URI (Supported for TiDB Cloud, Aiven, PlanetScale, Railway, AWS RDS)
# DATABASE_URL=mysql://user:password@gateway.region.tidbcloud.com:4000/smartnest_db?ssl={"rejectUnauthorized":true}

# ------------------------------------------------------------------------------
# 3. FRONTEND CLIENT CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
# When Frontend and Backend are on the same domain (e.g. Vercel Serverless):
# Leave VITE_API_URL empty or set to /api
VITE_API_URL=

# If your backend is deployed on an external server (e.g. Render / Railway / VPS):
# VITE_API_URL=https://smartnest-api.onrender.com

# ------------------------------------------------------------------------------
# 4. OPTIONAL REAL-TIME SYNC (Supabase - Optional)
# ------------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
